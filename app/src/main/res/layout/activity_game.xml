<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FIELD -->
    <com.example.myapplication.BaseballFieldView
        android:id="@+id/baseballFieldView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnEndGame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- END GAME BUTTON -->
    <Button
        android:id="@+id/btnEndGame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="End Game"
        android:layout_margin="8dp"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/btnPitch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- PITCH BUTTON -->
    <Button
        android:id="@+id/btnPitch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pitch"
        android:textSize="18sp"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toTopOf="@+id/pitchPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- PITCH PANEL (HIDDEN INITIALLY) -->
    <GridLayout
        android:id="@+id/pitchPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:visibility="gone"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1 -->
        <Button android:id="@+id/btnBall" android:text="Ball" style="@style/PitchButton"/>
        <Button android:id="@+id/btnStrike" android:text="Strike" style="@style/PitchButton"/>
        <Button android:id="@+id/btnFoul" android:text="Foul" style="@style/PitchButton"/>

        <!-- Row 2 -->
        <Button android:id="@+id/btnOut" android:text="Out" style="@style/PitchButton"/>
        <Button android:id="@+id/btnSingle" android:text="Single" style="@style/PitchButton"/>
        <Button android:id="@+id/btnDouble" android:text="Double" style="@style/PitchButton"/>

        <!-- Row 3 -->
        <Button android:id="@+id/btnTriple" android:text="Triple" style="@style/PitchButton"/>
        <Button android:id="@+id/btnHomerun" android:text="HR" style="@style/PitchButton"/>
        <Button android:id="@+id/btnDoublePlay" android:text="DP" style="@style/PitchButton"/>

        <!-- Row 4 -->
        <Button android:id="@+id/btnTriplePlay" android:text="TP" style="@style/PitchButton"/>
        <Button android:id="@+id/btnFC" android:text="FC" style="@style/PitchButton"/>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>